{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goals",
    "niche_guidance",
    "opportunities",
    "unresolved_sources"
  ],
  "properties": {
    "goals": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "issuer",
          "url"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "issuer": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "niche_guidance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "niche",
          "reason"
        ],
        "properties": {
          "niche": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "provider",
          "unit",
          "deliverable",
          "evidence_scope",
          "materials_url",
          "target",
          "lab_type",
          "priority",
          "adoption",
          "checked_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "deliverable": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "access": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "materials_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "collection_path",
              "has_subdomain"
            ],
            "properties": {
              "collection_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "has_subdomain": {
                "type": "boolean"
              },
              "ordered": {
                "type": "boolean"
              },
              "tools": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "goals": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              }
            }
          },
          "lab_type": {
            "enum": [
              "exercise",
              "challenge",
              "problem-set",
              "question-bank",
              "project",
              "experiment"
            ]
          },
          "priority": {
            "enum": [
              "next",
              "later",
              "explore"
            ]
          },
          "adoption": {
            "enum": [
              "direct",
              "adaptation",
              "reference-only"
            ]
          },
          "checked_on": {
            "type": "string",
            "format": "date"
          },
          "item_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "unresolved_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "url",
          "reason"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
