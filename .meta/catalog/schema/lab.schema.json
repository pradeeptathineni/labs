{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lab metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "type", "skills", "source", "tracking"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "summary": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "type": {"enum": ["exercise", "challenge", "problem-set", "question-bank", "project", "experiment"]},
    "difficulty": {"enum": ["beginner", "intermediate", "advanced"]},
    "skills": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "goals": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["provider"],
      "properties": {
        "provider": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "item_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "links": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "solution": {"$ref": "#/$defs/link"},
        "demo": {"$ref": "#/$defs/link"}
      }
    },
    "tracking": {
      "type": "object", "additionalProperties": false, "required": ["status", "dates"],
      "properties": {
        "status": {"enum": ["not-started", "in-progress", "complete", "paused", "abandoned"]},
        "dates": {
          "type": "object", "additionalProperties": false,
          "required": ["created", "started", "updated", "completed"],
          "properties": {
            "created": {"type": "string", "format": "date"},
            "started": {"type": ["string", "null"], "format": "date"},
            "updated": {"type": "string", "format": "date"},
            "completed": {"type": ["string", "null"], "format": "date"}
          }
        },
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  },
  "$defs": {
    "link": {"type": "string", "anyOf": [
      {"format": "uri", "pattern": "^https?://"},
      {"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|#|$))[a-zA-Z0-9._/-]+(?:#[a-zA-Z0-9._-]+)?$"}
    ]}
  }
}
